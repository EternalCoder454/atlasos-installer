# The dev container (app/Containerfile.dev) with Telamon.Ui installed, built
# from atlas-framework's source: the build context named "atlas-framework".
# app/dev.sh builds it:
#
#   podman build --build-context atlas-framework=<atlas-framework checkout> \
#     -t localhost/telamon-installer-dev:telamon-ui -f app/Containerfile.telamon-ui app
#
# The ISO build uses the Telamon.Ui of the Telamon OS image instead
# (iso/Containerfile.telamon-ui).
FROM localhost/telamon-installer-dev
# Telamon.Ui's own build dependencies
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    dnf -y -q --setopt=keepcache=1 --setopt=install_weak_deps=False install \
        kf6-kwindowsystem-devel kf6-kconfig-devel \
    && dnf clean all
# COPY rather than a bind mount: its content is the cache key, so a change in
# atlas-framework rebuilds this step. The CMake build is a cache mount at a
# fixed path, so that rebuild only compiles what changed. Output built with
# another Qt or compiler can't be trusted (moc and qmlcachegen aren't tracked
# as dependencies): the build starts over when they change.
COPY --from=atlas-framework --exclude=.git --exclude=build --exclude=out --exclude=template / /atlas-framework
RUN --mount=type=cache,target=/var/cache/telamon-ui-build,sharing=locked \
    toolchain=$(rpm -q gcc-c++ cmake qt6-qtbase-devel qt6-qtdeclarative-devel kf6-kirigami-devel kf6-kconfig-devel kf6-kwindowsystem-devel) \
    && if [ "$(cat /var/cache/telamon-ui-build/.toolchain 2>/dev/null)" != "$toolchain" ]; then \
        rm -rf /var/cache/telamon-ui-build/* /var/cache/telamon-ui-build/.[!.]* \
        && printf '%s\n' "$toolchain" >/var/cache/telamon-ui-build/.toolchain; \
    fi \
    && cmake -S /atlas-framework -B /var/cache/telamon-ui-build -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr -DTELAMON_BUILD_GALLERY=OFF >/dev/null \
    && cmake --build /var/cache/telamon-ui-build \
    && cmake --install /var/cache/telamon-ui-build >/dev/null
