# Adapted from plasma-setup's kglobalaccelrc, which the image no longer
# ships. The installer's live session allows only a few essential global
# shortcuts, so nothing can interfere with the install: the screen reader
# and zoom.

[General]
useAllowList=true

[AllowedShortcuts]
kaccess=Toggle Screen Reader On and Off
kwin=MoveZoomDown,MoveZoomLeft,MoveZoomRight,MoveZoomUp,view_actual_size,view_zoom_in,view_zoom_out
