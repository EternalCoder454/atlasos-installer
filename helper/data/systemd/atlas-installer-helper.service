[Unit]
Description=AtlasOS installer helper (partitions a disk and runs bootc install)
Documentation=https://github.com/EternalCoder454/atlasos-installer

[Service]
Type=dbus
BusName=net.eterneon.atlas.InstallerHelper
ExecStart=/usr/libexec/atlas-installer-helper
# No sandboxing on purpose (no ProtectSystem, PrivateTmp, PrivateMounts,
# ProtectHome, NoNewPrivileges, ...). The helper writes partition tables,
# formats and mounts filesystems under /run/atlas-target, runs bootc against
# the live system's container storage and writes firmware boot entries; the
# mounts must be visible to bootc and to the user's session. It exits by
# itself after 60 seconds without calls, except once an install has started
# or the computer is restarting (it then holds the install's result and its
# busy flag until stopped). A cleanup umount that is running is not stopped.
#
# Stopping: the helper handles SIGTERM itself. It refuses new calls, releases
# its bus name and waits for a running install (up to 40 s), then stops its
# commands. An install stopped half-way leaves the target disk unbootable (the
# disk is re-installed from scratch next time), which is why the helper holds
# a logind block inhibitor for shutdown and sleep while Install runs.
# KillMode=mixed sends SIGTERM to the helper only and SIGKILL to leftovers
# when TimeoutStopSec runs out.
KillMode=mixed
TimeoutStopSec=60
# The helper locks its memory (mlockall) so secrets never reach swap. Root has
# CAP_IPC_LOCK (no CapabilityBoundingSet here); the limit is lifted for it. If
# mlockall still fails the helper only logs a warning and carries on.
LimitMEMLOCK=infinity
# No core dumps (the helper holds disk passwords; main.rs also clears the
# dumpable flag), and a few restrictions that cost the install nothing.
# Left off on purpose: NoNewPrivileges (blocks the SELinux domain transition
# of bootc's install_t on an enforcing system), RestrictSUIDSGID (bootc writes
# setuid files into the target), ProtectClock (adds a DeviceAllow list, which
# closes block-device access), ProtectKernelTunables, PrivateMounts,
# ProtectHome and RestrictNamespaces (the mounts and bootc need them).
# If bootc or a child ever fails with EPERM, LockPersonality, RestrictRealtime
# and SystemCallArchitectures are the first lines to drop.
LimitCORE=0
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
