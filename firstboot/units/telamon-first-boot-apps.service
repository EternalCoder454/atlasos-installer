[Unit]
Description=Install the apps chosen in the Telamon OS installer
Wants=network-online.target
# After multi-user.target too, so the boot is not held up for the retries while offline.
After=network-online.target multi-user.target
# The record under the new name, or under the old one (Atlas Installer's, and
# an installed system's that has not run the first start yet): either starts it.
ConditionPathExists=|/var/lib/telamon/first-boot-apps.json
ConditionPathExists=|/var/lib/atlasos/first-boot-apps.json

[Service]
Type=oneshot
ExecStart=/usr/libexec/telamon/telamon-first-boot-apps system
TimeoutStartSec=3h
Restart=on-failure
RestartSec=30
RestartSteps=6
RestartMaxDelaySec=30min
# 78 is a failure that retrying cannot fix (damaged record, no flatpak).
RestartPreventExitStatus=78
# Flatpak needs user namespaces and /var. Its bwrap mounts /proc (apply_extra and
# triggers), so ProtectKernelTunables and ProtectControlGroups stay off.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ProtectKernelModules=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
