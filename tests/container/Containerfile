# What tests/container/crypt-flow.sh needs: the real cryptsetup and
# systemd-cryptenroll, jq, and a Rust toolchain for the parser check.
FROM registry.fedoraproject.org/fedora:44
RUN dnf install -y --setopt=install_weak_deps=False cryptsetup systemd systemd-udev jq coreutils cargo gcc \
    && dnf clean all
